{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pusatku-connect",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application",
    "exclude": [
      "node_modules/**",
      ".git/**",
      "wrangler.jsonc",
      "package.json",
      "package-lock.json"
    ]
  }
}
